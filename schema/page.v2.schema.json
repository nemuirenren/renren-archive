{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "book-page.v2.schema.json",
  "title": "Book page · standar v2",
  "description": "Satu file = satu halaman buku. Dipakai untuk semua buku di folder JSON/.",
  "type": "object",
  "required": [
    "schema_version",
    "book",
    "page",
    "page_label",
    "kind",
    "outline",
    "blocks"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "book": {
      "type": "object",
      "required": [
        "id",
        "title",
        "lang"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[^\\s/\\\\]+$",
          "description": "Slug buku, sama dengan nama folder di JSON/. Contoh: chugaku-rika"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "lang": {
          "type": "string",
          "pattern": "^[a-z]{2}(-[A-Za-z0-9]+)?$",
          "description": "Kode bahasa ISO 639-1, mis. ja, id, en"
        }
      }
    },
    "page": {
      "type": "integer",
      "minimum": 1,
      "description": "Nomor urut halaman file (PDF), mulai 1. Harus sama dengan angka di nama file pXXX.json"
    },
    "page_label": {
      "type": "string",
      "description": "Nomor halaman seperti tercetak (bisa '117', 'iv', '12-3', atau '' kalau tidak bernomor)"
    },
    "kind": {
      "enum": [
        "cover",
        "front_matter",
        "toc",
        "content",
        "exercise",
        "appendix",
        "index",
        "glossary",
        "colophon",
        "blank"
      ],
      "description": "Jenis halaman"
    },
    "outline": {
      "type": "array",
      "description": "Jalur struktur dari terluar ke terdalam, mis. [{level:1,title:'第2章 地学分野'},{level:2,title:'テーマ18 前線・気圧配置'}]",
      "items": {
        "type": "object",
        "required": [
          "level",
          "title"
        ],
        "additionalProperties": false,
        "properties": {
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "description": "Isi halaman, urut sesuai alur baca",
      "items": {
        "type": "object",
        "required": [
          "type",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": [
              "heading",
              "text",
              "table",
              "figure"
            ]
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "if": {
          "properties": {
            "type": {
              "const": "heading"
            }
          },
          "required": [
            "type"
          ]
        },
        "then": {
          "required": [
            "level"
          ],
          "description": "Blok heading wajib punya level"
        }
      }
    }
  }
}