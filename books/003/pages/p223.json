   "text": "13. 聞く【き・く】(u-verb) - to ask; to listen"
  },
  {
   "type": "text",
   "text": "14. 伺う【うかが・う】(u-verb) - to ask; to listen (humble)"
  },
  {
   "type": "text",
   "text": "15. 言う【い・う】(u-verb) - to say"
  },
  {
   "type": "text",
   "text": "16. おっしゃる - to say (honorific)"
  },
  {
   "type": "text",
   "text": "17. 申す【もう・す】(u-verb) - to say (humble)"
  },
  {
   "type": "text",
   "text": "18. 申し上げる【もう・し・あ・げる】(u-verb) - to say (humble)"
